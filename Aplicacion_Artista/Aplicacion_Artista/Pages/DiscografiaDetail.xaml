<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Aplicacion_Artista.Pages.DiscografiaDetail"
             Title="DiscografiaDetail"
             BackgroundColor="{DynamicResource BackgroundMain}">
    <VerticalStackLayout Spacing="20" Padding="20">

        <Border StrokeShape="RoundRectangle 15" 
            StrokeThickness="0" 
            BackgroundColor="Transparent">
            <Image x:Name="albumImage" 
               Aspect="AspectFill" 
               HeightRequest="250" 
               WidthRequest="400" />
        </Border>

        <VerticalStackLayout Spacing="5">
            <Label x:Name="albumLabel" 
               Style="{DynamicResource TitleStyle}"
               HorizontalOptions="Center"/>

            <Label x:Name="añoLabel" 
               Style="{DynamicResource SubtitleStyle}"
               HorizontalOptions="Center" />
        </VerticalStackLayout>

        <BoxView HeightRequest="1" Color="#3b5266" Margin="0,10" />

        <Label Text="Detalle:" 
          Style="{DynamicResource SubtitleStyle}"/>

        <Label x:Name="descripcionLabel" 
           TextColor="{DynamicResource Text}" 
           FontSize="16" 
           LineHeight="1.2" />

    </VerticalStackLayout>
</ContentPage>